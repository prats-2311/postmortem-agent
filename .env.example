# Lemma — tracing/observability for this agent's own LLM calls,
# and an optional 6th evidence source when an incident involves an AI agent failure.
# Get these from https://app.uselemma.ai (Settings > API Keys, and your project id).
LEMMA_API_KEY=
LEMMA_PROJECT_ID=
LEMMA_RELEASE=

# Model — Groq (fast, free-tier friendly). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Evidence sources
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

SLACK_BOT_TOKEN=
SLACK_INCIDENT_CHANNEL_ID=

GITHUB_TOKEN=
GITHUB_REPO=

# Publish targets
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

LINEAR_API_KEY=
LINEAR_TEAM_ID=

# Optional — only needed if you re-enable the Arga MCP exploration (see README > On Arga Labs)
ARGA_API_KEY=
